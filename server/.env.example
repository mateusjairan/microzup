# Microzup — contrato de configuração do servidor.
# Copie para `.env` e preencha. O `.env` real NUNCA vai para o Git.
# Toda variável aqui tem linha correspondente em docs/plano-mvp.md §8.

# ── Aplicação ─────────────────────────────────────────────
APP_ENV=development
HOST=0.0.0.0
PORT=8666
LOG_LEVEL=INFO

# ── Banco de dados ────────────────────────────────────────
# Runtime: papel microzup_app (sem UPDATE/DELETE em audit_log)
DATABASE_URL=postgresql+psycopg://microzup_app:change-me@localhost:55432/microzup
# Migrations: papel microzup_owner, usado somente pelo Alembic
MIGRATION_DATABASE_URL=postgresql+psycopg://microzup_owner:change-me@localhost:55432/microzup
# Timeouts por conexão no engine (plano §8)
STATEMENT_TIMEOUT_MS=15000
IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000

# ── Segurança ─────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-minimum-32-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
WS_TICKET_TTL_SECONDS=30
LOGIN_MAX_ATTEMPTS=5
# Liberação do bloqueio progressivo (dobra a cada ciclo, até 1 h)
LOGIN_LOCKOUT_SECONDS=300
# Rate limit em memória (plano §8): eventos por minuto
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_MESSAGE_PER_MINUTE=30

# ── HTTP ──────────────────────────────────────────────────
# SPA servida pela própria API (mesma origem): deixe vazio em produção.
# Preencha apenas para um front externo durante o desenvolvimento.
CORS_ORIGINS=
# Build do SPA servido em `/` (relativo à raiz do repositório).
WEB_DIST_DIR=web/dist
# Cookie de refresh com `Secure`; ligue quando o piloto migrar para TLS/HTTPS.
COOKIE_SECURE=false

# ── Arquivos e limites ────────────────────────────────────
STORAGE_DIR=./data
MAX_UPLOAD_MB=100
MAX_ATTACHMENTS_PER_MESSAGE=5
ORPHAN_ATTACHMENT_TTL_HOURS=24
MESSAGE_MAX_CHARS=8000

# ── Logs (JSON em stdout E arquivo com rotação diária) ────
LOG_DIR=./data/logs
LOG_RETENTION_DAYS=14

# ── Retenção (0 = desligado) ──────────────────────────────
MESSAGE_RETENTION_DAYS=0
FILE_RETENTION_DAYS=0
# Intervalo da task de retenção no lifespan; 0 desliga a task (CLI segue disponível)
RETENTION_INTERVAL_SECONDS=3600
