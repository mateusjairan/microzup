{
  "name": "microzup-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Microzup — cliente desktop de chat corporativo",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p electron --watch --preserveWatchOutput\" \"esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --watch --outfile=electron/dist/preload.js\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/run-electron.mjs\"",
    "typecheck": "tsc --noEmit && tsc -p electron --noEmit",
    "test:e2e": "playwright test",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p electron && npm run build:preload",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/dist/preload.js",
    "start": "node scripts/run-electron.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.microzup.desktop",
    "productName": "Microzup",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "date-fns": "^4.4.0",
    "electron-store": "^12.0.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.23",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.13.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
